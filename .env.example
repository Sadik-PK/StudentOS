DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001
FRONTEND_ORIGINS=http://localhost:8443
PORT=3001

# Configure one AI provider on the server. Gemini is the default.
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_GEMINI_MODEL=gemini-2.5-flash
AI_OPENAI_MODEL=gpt-4o-mini

# App-owned Google Drive storage. OAuth setup needs the client ID/secret,
# redirect URI, encryption key, and verified admin email. An existing refresh
# token can be supplied instead of completing initial OAuth authorization.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3001/api/integrations/google-drive/callback
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_ADMIN_EMAIL=
